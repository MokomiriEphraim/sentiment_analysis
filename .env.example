# OPENAI_API_KEY: Required for the neural analysis endpoint (/api/neural-deep-sense).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# OPENAI_MODEL (optional): defaults to gpt-4o-mini. Use any chat model your key can access.
OPENAI_MODEL="gpt-4o-mini"

# OPENAI_TRANSCRIBE_MODEL (optional): voice input on Firefox/Safari goes through
# /api/transcribe; defaults to whisper-1 (cheap per-minute speech-to-text).
# OPENAI_TRANSCRIBE_MODEL="whisper-1"

# RESEND_API: powers "send the report to name@gmail.com" in the help assistant.
# Optional RESEND_FROM — default onboarding@resend.dev (Resend sandbox: only
# delivers to your own account email until you verify a domain).
RESEND_API=""
# RESEND_FROM=""

# OPENAI_BASE_URL (optional): override for proxies/compatible endpoints.
OPENAI_BASE_URL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PYTHON_URL (optional): Python VADER sidecar base URL for /api/py-analyze.
# Defaults to http://127.0.0.1:8000; start with `npm run sidecar`.
PYTHON_URL="http://127.0.0.1:8000"

# MONGO_URI (optional): MongoDB connection string. When set, every scraped
# comment pull is persisted and linked to the browser device that ran it
# (collections: devices, pulls, comments). Without it the app runs fully;
# scrapes just aren't saved.
MONGO_URI=""

# MONGO_DB (optional): database name inside the cluster (default: URI's db).
MONGO_DB="cloud_sentiment"

# FIRECRAWL_API_KEY: comment scraper (/api/scrape-comments) for platforms WITHOUT
# an Apify actor — Facebook / X / Reddit links on the Live Comments tab.
# Get one at https://firecrawl.dev (Settings -> API Keys).
FIRECRAWL_API_KEY=""

# APIFY_API_KEY: TikTok + Instagram + YouTube comments (/api/scrape-comments).
# Each platform has a dedicated Apify actor (Firecrawl refuses tiktok.com, can't
# read IG, and returns 0 YouTube comments): clockworks/tiktok-scraper,
# apify/instagram-scraper (resultsType "comments", ~15/post on the free plan),
# streamers/youtube-comments-scraper.
# Free account: https://console.apify.com → Settings → Integrations → API tokens.
APIFY_API_KEY=""
